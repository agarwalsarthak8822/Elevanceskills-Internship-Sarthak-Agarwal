# ============================================================================
#  YourTube 2.0 — BACKEND environment variables (server/)
#  Copy this file to `.env` and fill in your own real values.
#  Never commit the real .env file. All values below are placeholders.
# ============================================================================

# ---- Core ------------------------------------------------------------------
# Port the Express/Socket.io server listens on. Render/Railway set PORT for you,
# so you usually only need this locally.
PORT=5000

# MongoDB connection string (MongoDB Atlas recommended for deployment).
DB_URL=mongodb+srv://your_user:your_password@cluster.mongodb.net/youtube

# Secret used to sign JWTs issued after OTP login. Use a long random string.
# If unset, the server falls back to an insecure dev default — ALWAYS set this
# in production.
JWT_SECRET=replace_with_a_long_random_secret

# ---- CORS / allowed frontend origins --------------------------------------
# Comma-separated list of origins allowed to call the API and open sockets.
# localhost is always allowed; add your deployed frontend URL here in prod.
# Example: CLIENT_URLS=https://your-app.vercel.app,https://www.yourdomain.com
CLIENT_URLS=https://your-app.vercel.app

# ---- Firebase (server-side ID token verification) --------------------------
# Web API key of your Firebase project. Used to verify Google/Firebase logins
# server-side. Same key as the frontend NEXT_PUBLIC_FIREBASE_API_KEY.
FIREBASE_API_KEY=your_firebase_web_api_key

# ---- Email (Nodemailer / Gmail) — OTP emails + payment invoices ------------
# Use a Gmail address and a Gmail "App Password" (NOT your normal password):
# https://myaccount.google.com/apppasswords  (requires 2-Step Verification)
# If left blank, OTP codes are logged to the server console (dev fallback).
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password

# ---- Razorpay (payments — Task 2 downloads & Task 3 plans) -----------------
# Test-mode keys from https://dashboard.razorpay.com/app/keys
# Both must belong to the SAME key pair or signature verification fails.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_matching_key_secret_from_dashboard

# ---- Twilio SMS (Task 4 — mobile OTP for non-South-India users) ------------
# From https://console.twilio.com  (Account SID + Auth Token + a Twilio number)
# If unset, mobile OTP codes are logged to the server console (dev fallback).
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ---- Twilio Video (Task 6 — friend video calls) ----------------------------
# API Key SID/Secret from https://console.twilio.com/us1/develop/video
# (Account > API keys & tokens). Uses the same TWILIO_ACCOUNT_SID above.
TWILIO_API_KEY_SID=your_twilio_video_api_key_sid
TWILIO_API_KEY_SECRET=your_twilio_video_api_key_secret

# ---- Translation (Task 1 — comment translator) -----------------------------
# The app tries Lingva first, then LibreTranslate. Defaults work without keys,
# but public instances are rate-limited; self-host or add a key for reliability.
LINGVA_URL=https://lingva.ml
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=
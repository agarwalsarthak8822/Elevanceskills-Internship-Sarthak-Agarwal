cat > .gitignore << 'EOF'
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*
server/.env
server/.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# server specific
server/node_modules/
server/uploads/*
!server/uploads/.gitkeep
yourtube/node_modules/
yourtube/.next/
EOF